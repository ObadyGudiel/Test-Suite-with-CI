{
  "name": "nexo-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node backend/server.js",
    "test": "node --test backend/tests/*.test.js",
    "test:unit": "node --test backend/tests/domain.test.js",
    "test:integration": "node --test backend/tests/api.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "test:load": "k6 run tests/load.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cypress": "^15.0.0",
    "supertest": "^7.0.0",
    "vite": "^7.0.0"
  }
}
